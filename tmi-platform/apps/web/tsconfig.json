{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tmi/contracts": ["./src/stubs/tmi-contracts.ts"],
      "@tmi/hud-core": ["./src/stubs/tmi-hud-core.ts"],
      "@tmi/hud-runtime": ["./src/stubs/tmi-hud-runtime.ts"],
      "@tmi/module-runtime": ["./src/stubs/tmi-module-runtime.ts"],
      "@bernout/agent-network": ["./src/stubs/bernout-agent-network.ts"],
      "@tmi/db": ["./src/stubs/tmi-db.ts"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "middleware.ts",
    "socket-server.ts",
    "capacitor.config.ts",
    "tailwind.config.ts",
    "jest.config.ts",
    "runObservatorySmoke.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "pages/**/*.ts",
    "pages/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/cache/**",
    ".next/server/**",
    ".next/static/**",
    ".next-*/**",
    "dist",
    "build",
    "out",
    "../../packages/**",
    "config/**",
    "environment/**",
    "events/**",
    "infrastructure/**",
    "runtime/**",
    "stimulation/**"
  ]
}
